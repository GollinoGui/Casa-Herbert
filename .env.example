# Supabase — Project Settings > API Keys (a chave secreta nunca vai para o navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Assina o cookie de sessão do painel. Gerar com: openssl rand -base64 48
AUTH_SECRET=

# "true" liga o site público. Qualquer outro valor (ou vazio) leva todas as páginas para o painel /admin.
SITE_ENABLED=

# Modo demonstração: dados de exemplo em memória, sem Supabase. Só em desenvolvimento;
# em produção o app se recusa a subir com isto ligado.
DEMO_MODE=
